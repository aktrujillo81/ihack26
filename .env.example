# Add names only. Never commit values or secrets.
# Exact variables are unknown until the provider setup and contracts are confirmed.

# Local database settings, used by both `npm run db:up` (Docker, compose.yaml)
# and `npm run db:local` (no Docker). Postgres binds to 127.0.0.1 only.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Server only. Postgres on the host, never exposed publicly.
DATABASE_URL=

# Map tiles. Set to "none" for a plain background with no tile requests.
NEXT_PUBLIC_MAP_TILES=

# Public map (cut from the spec; off unless both are set). Server only. One organization id and a comma-separated list of its region ids.
PUBLISHED_MAP_ORGANIZATION_ID=
PUBLISHED_MAP_REGION_IDS=

# Server only. The shared secret from the Vapi credential (task S4 step 7).
# Vapi routes refuse every request while it is unset.
VAPI_WEBHOOK_SECRET=

# Server only. Key for the keyed HMAC of the Vapi call id (task D3a). A separate
# secret, at least 32 characters (e.g. `openssl rand -base64 32`). Never reuse
# BETTER_AUTH_SECRET or VAPI_WEBHOOK_SECRET. Unset or too short: the webhook answers 503.
VAPI_CALL_REF_KEY=

# Server only. Better Auth (task A1). Never used in browser code.
# BETTER_AUTH_SECRET: random, at least 32 characters (e.g. `openssl rand -base64 32`).
# BETTER_AUTH_URL: the public origin. Host: https://bg.verilen.com. Local: http://127.0.0.1:6543
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Demo account passwords for `npm run db:seed` (one per role). Each 12 to 128
# characters; the seed exits otherwise. Never printed or logged.
SEED_ADMIN_PASSWORD=
SEED_RESPONDER_PASSWORD=
SEED_VIEWER_PASSWORD=

# Optional, tests only. Integration tests drop and recreate the database named
# here; it must be called wellwatch_test. Unset: they use the db:local server
# from DATABASE_URL (port 5434) and refuse any other port.
TEST_DATABASE_URL=
